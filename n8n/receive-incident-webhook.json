      "typeVersion": 1,
      "position": [
        -460,
        -140
      ],
      "webhookId": "incidentflow-inbound"
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{$json.event}}",
              "operation": "equals",
              "value2": "incident.created"
            }
          ]
        }
      },
      "id": "if-created",
      "name": "Incident Created?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        -200,
        -140
      ]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{$json.incident.severity}}",
              "operation": "equals",
              "value2": "critical"
            },
            {
              "value1": "={{$json.incident.severity}}",
              "operation": "equals",
              "value2": "high"
            }
          ],
          "combinator": "or"
        }
      },
      "id": "if-high-severity",
      "name": "High/Critical Severity?",
