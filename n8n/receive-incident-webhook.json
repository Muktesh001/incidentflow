            {
              "name": "payload.incidentId",
              "value": "={{$json.incidentId}}"
            },
            {
              "name": "payload.note",
              "value": "=🤖 Automated analysis summary:\\n{{ JSON.stringify($node['Call Incident AI Analyze'].json, null, 2) }}"
