              }
            ]
          },
          "options": {}
        }
      },
      "id": "set-ai-prompt",
      "name": "Set AI Prompt",
      "type": "n8n-nodes-base.set",
      "typeVersion": 1,
      "position": [
        280,
        -300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.INCIDENTFLOW_API_BASE}}/api/incidents/{{$json.incidentId}}/analyze",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-n8n-api-key",
              "value": "={{$env.N8N_API_KEY}}"
            }
          ]
        },
        "options": {}
      },
      "id": "ai-analyze-call",
      "name": "Call Incident AI Analyze",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 1,
      "position": [
        520,
        -300
      ]
    },
    {
      "parameters": {
        "content": "=🚨 High-Severity Incident #{{$json.incidentId}}\\nTitle: {{$json.incident.title}}\\nService: {{$json.incident.service}}\\nSeverity: {{$json.incident.severity}}\\nURL: {{$env.INCIDENTFLOW_API_BASE}}/#/incidents/{{$json.incidentId}}",
        "options": {}
      },
      "id": "notify-slack-placeholder",
      "name": "Notify Slack (configure)",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        280,
        -180
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.INCIDENTFLOW_API_BASE}}/api/webhooks/n8n",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-n8n-api-key",
              "value": "={{$env.N8N_API_KEY}}"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "action",
