PORT=5000
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=incidentflow
JWT_SECRET=your_jwt_secret_change_me_min_32_chars
JWT_EXPIRES_IN=7d
AUTH_REQUIRED=false
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-1.5-flash-latest
N8N_WEBHOOK_URL=your_n8n_webhook_url
N8N_API_KEY=your_n8n_api_key
INCIDENTFLOW_API_BASE=http://localhost:5000
CORS_ORIGIN=*
LOG_LEVEL=info
NODE_ENV=development

# ── Rate limiting ──────────────────────────────────────────────────
# Global limiter: max requests per client IP within the window
# Default: 600 req / 60 sec (=10 rps) per IP.
RATE_LIMIT_WINDOW_SEC=60
RATE_LIMIT_MAX=600

# Auth limiter: stricter caps to slow brute-force attempts
# Default: 15 req / 900 sec (= 15 min) per IP for login/register.
RATE_LIMIT_AUTH_WINDOW_SEC=900
RATE_LIMIT_AUTH_MAX=15

# ── Production overrides (set these in production) ─────────────────
# NODE_ENV=production
# AUTH_REQUIRED=true
# CORS_ORIGIN=https://app.yourdomain.com
# JWT_EXPIRES_IN=15m
# LOG_LEVEL=warn